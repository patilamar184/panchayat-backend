# Copy to .env and replace every placeholder. .env is git-ignored; never commit it.

# --- PostgreSQL container (used by docker-compose.yml) ---
POSTGRES_USER=panchayat
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=panchayat

# --- API settings ---
ENVIRONMENT=development
# Used when you run the API on your own machine (outside Docker).
# Port 5433 is the host port Docker publishes for this project's database.
DATABASE_URL=postgresql+psycopg://panchayat:change-me-to-a-long-random-value@localhost:5433/panchayat
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=5242880
MAX_IMAGES_PER_COMPLAINT=5
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
